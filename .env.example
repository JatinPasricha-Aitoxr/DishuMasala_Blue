# Copy this file to .env and fill in real values. Never commit .env.
#
# No secret in this file may ever carry a NEXT_PUBLIC_ prefix — that prefix tells Next.js to
# inline the value into the client JS bundle. The only NEXT_PUBLIC_ variable below
# (NEXT_PUBLIC_SITE_URL) is the site's own public URL, not a secret. CLAUDE.md §3.3 / §10.

# --- Database (Neon Postgres via Drizzle) ---------------------------------------------------
# Neon connection string, e.g. postgres://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
# Use a pooled/branch connection string for the deployed app; drizzle-kit and scripts/ work
# against the same variable.
#
# Before a real Neon project exists, you can point this at a local Docker Postgres instead
# (postgres://postgres:postgres@localhost:5433/dishu). drizzle-kit and scripts/ (seed,
# migrate-images) talk plain Postgres wire protocol and work against it directly. The deployed
# app's own client (lib/db/index.ts) uses the Neon serverless driver, which only speaks to Neon's
# proxy — talking to a local Postgres additionally needs Neon's local wsproxy sidecar
# (`docker run -p 4444:80 -e APPEND_PORT=<container>:5432 -e ALLOW_ADDR_REGEX=.* ghcr.io/neondatabase/wsproxy`),
# which lib/db/index.ts auto-detects and routes through whenever DATABASE_URL's host is
# localhost/127.0.0.1 (override the proxy port with NEON_LOCAL_WS_PROXY_PORT, default 4444).
DATABASE_URL=

# --- Auth.js v5 --------------------------------------------------------------------------------
# Random 32+ byte secret used to sign session cookies/tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=
# The canonical URL Auth.js should treat as the app's own origin (e.g. https://dishumasala.com in
# production, http://localhost:3000 in dev).
AUTH_URL=

# --- Cloudflare R2 (S3-compatible object storage for product/review/post images) ---------------
# The Cloudflare account id that owns the R2 bucket.
R2_ACCOUNT_ID=
# R2 API token access key id (Cloudflare dashboard → R2 → Manage API tokens).
R2_ACCESS_KEY_ID=
# R2 API token secret access key — keep this out of logs and error messages.
R2_SECRET_ACCESS_KEY=
# Name of the R2 bucket images are uploaded to.
R2_BUCKET=
# The public base URL images are served from (a custom domain or R2.dev public bucket URL), e.g.
# https://media.dishumasala.com — used both by next.config.ts's images.remotePatterns and by
# lib/storage/r2.ts's publicUrl().
R2_PUBLIC_BASE_URL=

# --- Resend (transactional email) ---------------------------------------------------------------
# Resend API key (Resend dashboard → API Keys).
RESEND_API_KEY=
# The verified "from" address/name transactional email is sent from, e.g. "Dishu Masala <orders@dishumasala.com>"
EMAIL_FROM=

# --- Razorpay (payments: UPI, cards, netbanking, wallets) ----------------------------------------
# Public-looking but still server-side — used to create Razorpay orders, never exposed to the client.
RAZORPAY_KEY_ID=
# Razorpay secret key — used to create orders server-side and verify payment signatures.
RAZORPAY_KEY_SECRET=
# Separate secret configured in the Razorpay dashboard for verifying incoming webhook signatures.
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (pincode serviceability, order push, tracking) -----------------------------------
# Shiprocket account email used to obtain an auth token.
SHIPROCKET_EMAIL=
# Shiprocket account password used to obtain an auth token.
SHIPROCKET_PASSWORD=

# --- Public ---------------------------------------------------------------------------------------
# The site's own public origin, safe to inline into the client bundle (not a secret), e.g.
# https://dishumasala.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
